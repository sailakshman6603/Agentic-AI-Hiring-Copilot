# App Settings
PROJECT_NAME="Agentic AI Hiring Copilot"
DEBUG=True
API_V1_STR="/api/v1"

# Security
JWT_SECRET="super-secret-key-change-in-production-1234567890"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/hiring_copilot"

# Redis & Celery
REDIS_URL="redis://redis:6379/0"
#REDIS_URL="redis://localhost:6379/0"

# Vector Store (Qdrant)
QDRANT_HOST="qdrant"
#QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="resumes"

# AI Configuration
# Get your API key from: https://console.groq.com/
GROQ_API_KEY="your-groq-api-key-here"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# OCR Settings
OCR_ENABLED=True
